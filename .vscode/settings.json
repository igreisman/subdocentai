rtime configuration\\\\\\.\"\\), new2, 'variant_2'\\),\n    \\(re\\.compile\\(re\\.escape\\(\"Eventually she was transferred to the city of San Francisco, where she opened as a museum ship at Pier 45, Fisherman's Wharf in 1982\\.\"\\)\\), new3, 'exact_3'\\),\n    \\(re\\.compile\\(r\"Eventually,\\? she was transferred to the city of San Francisco, where she opened as a museum ship at Pier 45, Fisherman's Wharf in 1982\\\\\\.\"\\), new3, 'variant_3'\\),\n\\]\n\nfor path in files:\n    text = path\\.read_text\\(encoding='utf-8'\\)\n    total = 0\n    stats = \\[\\]\n    for rx, repl, label in patterns:\n        text, n = rx\\.subn\\(repl, text\\)\n        if n:\n            total \\+= n\n            stats\\.append\\(f\"\\{label\\}=\\{n\\}\"\\)\n    path\\.write_text\\(text, encoding='utf-8'\\)\n    print\\(f\"\\{path\\}: replacements=\\{total\\}\" \\+ \\(\" \\(\" \\+ \", \"\\.join\\(stats\\) \\+ \"\\)\" if stats else \"\"\\)\\)\nPY\nrg -n --no-heading -e 'transferred to the city of San Francisco\\|Maritime Park Association and is operated by\\|acquired for preservation\\|opened as a museum ship at Pier 45' corpora/dieselsubs_faq_corpus\\.jsonl 'corpora/dieselsubs_faq_corpus\\.jsonl copy'$/": {
