ENTRY_SETS = {
    "pacific-campaign": PACIFIC_CAMPAIGN_ENTRIES,
}


def load_jsonl(path: Path) -> list[dict]:
    rows: list[dict] = []
    if not path.exists():
        return rows
    with path.open("r", encoding="utf-8") as handle:
        for line in handle:
            line = line.strip()
            if line:
                rows.append(json.loads(line))
    return rows


def save_jsonl(path: Path, rows: list[dict]) -> None:
    tmp_path = path.with_suffix(path.suffix + ".tmp")
    with tmp_path.open("w", encoding="utf-8") as handle:
        for row in rows:
            handle.write(json.dumps(row, ensure_ascii=False) + "\n")
    tmp_path.replace(path)


def next_chunk_id(rows: list[dict]) -> str:
    max_value = 0
    for row in rows:
        match = re.search(r"(\d+)$", str(row.get("chunk_id") or ""))
        if match:
            max_value = max(max_value, int(match.group(1)))
    return f"ops_{max_value + 1:03d}"


def chunk_id_number(chunk_id: str) -> int:
    match = re.search(r"(\d+)$", chunk_id or "")
    return int(match.group(1)) if match else -1


def entry_key(entry: dict) -> tuple[str, str]:
    return (str(entry.get("title") or "").strip(), str(entry.get("source_url") or "").strip())


def materialize_entries(rows: list[dict], template_entries: list[dict]) -> tuple[list[dict], list[str]]:
    existing_keys = {entry_key(row): row for row in rows}
    created_ids: list[str] = []
    for template in template_entries:
        key = entry_key(template)
        if key in existing_keys:
            continue
        chunk_id = next_chunk_id(rows)
        rows.append({
            "chunk_id": chunk_id,
            "doc_type": "dieselsubs_operations_guide",
            "section": template["section"],
            "title": template["title"],
            "text": template["text"],
            "display_citation": template["display_citation"],
            "source_url": template["source_url"],
        })
        created_ids.append(chunk_id)
    rows.sort(key=lambda row: chunk_id_number(str(row.get("chunk_id") or "")))
    return rows, created_ids


def usage() -> int:
    print("Usage: bin/import-maritime-operations-guide <set-name> [--dry-run]")
    print("Available sets:")
    for key in sorted(ENTRY_SETS):
        print(f"  - {key}")
    return 1


def main() -> int:
    args = [arg for arg in sys.argv[1:] if arg != "--dry-run"]
    dry_run = "--dry-run" in sys.argv[1:]
    if len(args) != 1 or args[0] not in ENTRY_SETS:
        return usage()

    set_name = args[0]
    rows = load_jsonl(OPERATIONS_GUIDE_PATH)
    updated_rows, created_ids = materialize_entries(rows, ENTRY_SETS[set_name])
    summary = {
        "set": set_name,
        "created": created_ids,
        "count_after": len(updated_rows),
        "dry_run": dry_run,
        "path": str(OPERATIONS_GUIDE_PATH.relative_to(REPO)),
    }
    print(json.dumps(summary, indent=2))
    if not dry_run:
        save_jsonl(OPERATIONS_GUIDE_PATH, updated_rows)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())